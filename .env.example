# ============================================
# AlphaWatch — Environment Configuration
# ============================================
# Copy this file to .env and fill in your values:
#   cp .env.example .env

# --- Google Gemini API ---
GEMINI_API_KEY=your-gemini-api-key-here

# --- News API Sources ---
# Get a free key at https://newsapi.org/register
NEWSAPI_KEY=your-newsapi-key-here

# --- Kafka ---
KAFKA_BOOTSTRAP_SERVERS=kafka:9092
KAFKA_CLIENT_ID=alphawatch

# --- Redis ---
REDIS_URL=redis://redis:6379

# --- MongoDB ---
MONGODB_URI=mongodb://mongodb:27017/alphawatch
MONGODB_DB_NAME=alphawatch

# --- API Gateway ---
API_PORT=3001
NODE_ENV=development

# --- Frontend ---
VITE_API_URL=http://localhost:3001
VITE_SOCKET_URL=http://localhost:3001

# --- Agent Worker ---
# Extraction agent model (fast, cheap)
EXTRACTION_MODEL=gemini-2.0-flash
# Reasoning agent model (deeper analysis)
REASONING_MODEL=gemini-2.5-flash
# Embedding model
EMBEDDING_MODEL=text-embedding-004

# --- Dedup ---
DEDUP_TTL_SECONDS=86400

# --- Rate Limiting ---
NEWSAPI_RATE_LIMIT=100
NEWSAPI_RATE_WINDOW_SECONDS=86400

# --- Fetcher Intervals (ms) ---
RSS_FETCH_INTERVAL_MS=60000
NEWSAPI_FETCH_INTERVAL_MS=120000

# --- Alert Thresholds ---
RELEVANCE_GATE_THRESHOLD=0.3
ALERT_SIGNIFICANCE_THRESHOLD=0.6
